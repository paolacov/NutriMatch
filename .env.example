# Plantilla de configuración de NutriMatch.
# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repositorio.

# ---------------------------------------------------------------------------
# Open Food Facts (OFF)
# ---------------------------------------------------------------------------
# OBLIGATORIO según la documentación de OFF: toda petición debe identificarse con
# un User-Agent propio. Formato exigido: NombreApp/Version (email de contacto).
OFF_USER_AGENT=NutriMatch/0.1.0 (tu-correo@ejemplo.com)

# Producción. Es el entorno correcto para el snapshot y para el escaneo puntual.
OFF_BASE_URL=https://world.openfoodfacts.org
# AVISO: https://world.openfoodfacts.net es el entorno de STAGING. Requiere auth
# básica (usuario off / contraseña off) y contiene una copia PARCIAL de la base.
# No usarlo para construir el snapshot ni para contar productos.

# Export diario en CSV comprimido: la vía recomendada por OFF para volúmenes
# grandes. Pesa 1,28 GB (medido el 2026-09-19).
OFF_CSV_EXPORT_URL=https://static.openfoodfacts.org/data/en.openfoodfacts.org.products.csv.gz

# Fecha del snapshot descargado, en formato AAAA-MM-DD.
# Se deja vacía: la rellena el script de ingesta para dejar la cita trazable.
SNAPSHOT_DATE=

# ---------------------------------------------------------------------------
# Persistencia local
# ---------------------------------------------------------------------------
# SQLite en modo WAL, solo para estado mutable y regenerable.
NUTRIMATCH_DB_PATH=nutrimatch.db

# ---------------------------------------------------------------------------
# Capa LLM (OPCIONAL)
# ---------------------------------------------------------------------------
# OPCIONAL. Si se deja vacía, la aplicación funciona igual: las explicaciones se
# generan con plantillas deterministas. El LLM nunca calcula, solo narra.
OPENAI_API_KEY=
