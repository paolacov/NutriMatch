# Plantilla de configuración de NutriMatch.
# Copia este archivo como .env y rellena los valores. .env no se sube al repositorio.

# ---------------------------------------------------------------------------
# Open Food Facts
# ---------------------------------------------------------------------------
# Toda petición a Open Food Facts se identifica con un User-Agent propio.
# Formato: NombreApp/Version (email de contacto).
OFF_USER_AGENT=NutriMatch/0.1.0 (tu-correo@ejemplo.com)

# Producción. Es el entorno del snapshot y de la consulta de un producto.
OFF_BASE_URL=https://world.openfoodfacts.org
# https://world.openfoodfacts.net es staging: pide autenticación básica
# (usuario off / contraseña off) y contiene una copia parcial de la base.
# No se usa para construir el snapshot ni para contar productos.

# Export diario en CSV comprimido. Pesa 1,28 GB (medido el 2026-09-19).
OFF_CSV_EXPORT_URL=https://static.openfoodfacts.org/data/en.openfoodfacts.org.products.csv.gz

# Fecha del snapshot descargado, en formato AAAA-MM-DD.
# Vacía hasta que el script de ingesta la escribe, para dejar la cita trazable.
SNAPSHOT_DATE=

# ---------------------------------------------------------------------------
# Persistencia local
# ---------------------------------------------------------------------------
# SQLite en modo WAL. Solo estado de uso, regenerable.
# En Vercel el código ignora esta ruta y escribe en /tmp/nutrimatch.db.
NUTRIMATCH_DB_PATH=nutrimatch.db

# Catálogo que carga la API (Catalog.from_referencia).
# 13 093 filas: nutrición del corte 20260929, 259 precios reales y calidad.
# El mismo nombre es el valor por defecto de src/nutrimatch/core/config.py.
# El archivo debe existir en datos/procesados/ con este nombre.
REFERENCIA_FILENAME=dataset_referencia_20261002.parquet
SNAPSHOT_ID=off_csv_20260929

# Opcional. Directorio relativo a la raíz donde viven los Parquet.
# Si se omite, el código usa datos/procesados.
# PROCESSED_DATA_DIR=datos/procesados

# ---------------------------------------------------------------------------
# Navegador
# ---------------------------------------------------------------------------
# Orígenes extra autorizados a llamar la API, separados por comas.
# http://localhost:4200 y http://127.0.0.1:4200 ya están en el código.
# Los dominios https://*.vercel.app también. En el despliegue, la interfaz
# y la API comparten dominio y el navegador no cruza orígenes.
# CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# Capa de lenguaje
# ---------------------------------------------------------------------------
# Si se deja vacía, las explicaciones salen de plantillas deterministas.
# El lenguaje narra hechos ya calculados. No puntúa.
# Copia este archivo a .env en la raíz del repositorio (no en frontend/)
# y reinicia FastAPI. La clave no va en código, en docs, en Angular ni en logs.
OPENAI_API_KEY=
# Si se omite, se usa gpt-4o-mini con temperatura 0.
# OPENAI_MODEL=gpt-4o-mini
