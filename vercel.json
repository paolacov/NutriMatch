{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    },
    "api": {
      "root": "api",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "^/(meta|search|products|catalog|ranking|cart|events|ai)(/.*)?$",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
