# Entornos virtuales
.venv/
venv/

# Caché y artefactos de Python
__pycache__/
*.pyc
build/
dist/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Node y Angular. frontend/.gitignore cubre lo mismo dentro de frontend/.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/
coverage/
*.log

# IDE y sistema
.idea/
*.swp
Thumbs.db

# Secretos locales: solo se versiona .env.example
.env

# Base SQLite de estado mutable (incluye los ficheros -wal y -shm del modo WAL).
# Es regenerable, no es fuente de verdad.
nutrimatch.db*

# Caché local de respuestas de APIs externas (ficha de Open Food Facts, Open Prices
# y PROFECO). Acelerador de re-ejecución, no una fuente de verdad ni un dump versionable.
datos/cache/

# Notebooks y sistema operativo
.ipynb_checkpoints/
.DS_Store

# ---------------------------------------------------------------------------
# Insumos externos grandes: NO se versionan.
# El export CSV comprimido de Open Food Facts pesa 1,28 GB y el ZIP de PROFECO
# "Quién es Quién en los Precios" unos 186 MB. Ambos se descargan con los
# scripts de ingesta y se citan por fecha de snapshot, no por copia en el repo.
# ---------------------------------------------------------------------------
datos/snapshots/*
datos/precios_qqp/*

# Excepción para los metadatos: git no desciende en un directorio excluido, así
# que hay que reabrir primero las carpetas de snapshot y excluir su contenido
# archivo a archivo.
!datos/snapshots/*/
datos/snapshots/*/*

# Derivados del snapshot.
# Entra el catálogo que abre la aplicación (8,8 MB) y su metadato.
# El resto de los Parquet de septiembre queda fuera de un `git add` nuevo:
# la API no los carga. Algunos scripts y pruebas sí los abren; esa
# dependencia está en docs/datos.md. Un archivo ya seguido por Git no
# deja de estarlo por esta regla.
# Las figuras PNG de datos/procesados/figuras_*/ siguen fuera.
datos/procesados/*
!datos/procesados/dataset_referencia_20261002.parquet
!datos/procesados/dataset_referencia_20261002_metadata.json
# Resúmenes del re-EDA de identidad (CSV chicos, citables; no sustituyen el Parquet).
!datos/procesados/re_eda_20260926/
!datos/procesados/re_eda_20260926/*.csv

# Capturas locales de códigos de barras usadas en prueba manual. No hacen
# falta para ejecutar la aplicación.
/prueba-codigo*.png

# PDF generado por scripts/render_documentacion_pdf.py. La fuente es el Markdown.
docs/NutriMatch_Documentacion_Tecnica_Completa.pdf

# Los metadatos de procedencia del snapshot (URL, Last-Modified, ETag, SHA-256,
# esquema y reconciliación) son la trazabilidad del dato: pesan poco y se
# versionan aunque el archivo crudo que describen no esté en el repo.
!datos/snapshots/*/_metadata.json

# Se conservan los marcadores de carpeta para que el árbol exista al clonar.
!**/.gitkeep
